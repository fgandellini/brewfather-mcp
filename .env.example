BREWFATHER_API_KEY=
BREWFATHER_API_USER_ID=

# Comma-separated Host header values the HTTP server will accept (DNS-rebinding protection).
# Only needed when running src/http_runner.py. Defaults to localhost:*,127.0.0.1:* if unset.
ALLOWED_HOSTS=

# If set, requires "Authorization: Bearer <token>" on every request to src/http_runner.py.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
